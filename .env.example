# Origin backend FSOS. Frontend origin harus terdaftar di CORS_ORIGINS backend.
VITE_API_ORIGIN=http://localhost:8000
VITE_API_PREFIX=/api/v1

# true  -> request dikirim ke /api/v1 lewat dev proxy Vite (hindari CORS saat development)
# false -> request langsung ke VITE_API_ORIGIN
VITE_USE_PROXY=false

# Saat build production, Vite memakai nilai dari .env.production:
# VITE_API_ORIGIN=https://api.foodsecurity.online

# Timeout request dalam milidetik
VITE_API_TIMEOUT_MS=20000

# Tenant code default untuk form login (opsional, memudahkan development).
# Menerima tenant code seperti FSOS_DEMO maupun UUID tenant.
# JANGAN isi kredensial nyata di file yang di-commit.
VITE_DEFAULT_TENANT=FSOS_DEMO

# Google Maps JavaScript API key untuk halaman live tracking.
# Batasi key berdasarkan HTTP referrer dan aktifkan hanya Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
